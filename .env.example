# Configuração do Bot Discord
DISCORD_TOKEN=seu_token_do_bot_discord_aqui
CLIENT_ID=seu_client_id_do_discord_aqui

# Configuração do SimulationCraft
SIMC_PATH=simc
# Exemplo Windows: SIMC_PATH=C:\Program Files\SimulationCraft\simc.exe
# Linux/Mac: SIMC_PATH=simc (se estiver no PATH) ou /usr/local/bin/simc

# Configurações do Bot
MAX_CONCURRENT_SIMS=3
CACHE_TTL=3600
TIMEOUT_MS=300000

# Opcional: Discord Guild ID para deploy mais rápido de comandos em desenvolvimento
GUILD_ID=seu_guild_id_para_testes