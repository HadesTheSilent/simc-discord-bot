{
  "name": "simc-discord-bot",
  "version": "1.3.0",
  "description": "Bot Discord avançado com integração SimulationCraft para simulações de DPS do World of Warcraft, com visualizações ricas e cache inteligente",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "test": "node tests/test-quick.js",
    "test:all": "node tests/test-simulate.js && node tests/test-complete-embed.js"
  },
  "keywords": ["discord", "bot", "wow", "simulationcraft", "dps", "world-of-warcraft", "simulation", "theorycraft"],
  "author": "Hadestws/Jullian",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "node-cache": "^5.1.2",
    "uuid": "^9.0.1",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=16.11.0"
  }
}